#!/usr/bin/env bash
#
# hackaton — comandos do projeto dentro do ambiente definido em compose.yaml.
# Para adicionar um comando, crie cmd_<nome> e registre-o em COMMANDS.
# Use "_" no nome da função para comandos que contenham "-".

set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
SERVICE="app"
COMPOSE_BIN=()

# "comando|descrição" — usado na listagem de ajuda.
COMMANDS=(
    "dev|Compila as imagens e inicia os serviços em segundo plano"
    "stop|Para os containers (aceita serviços e opções do Compose)"
    "down|Remove containers e rede, preservando volumes por padrão"
    "restart|Reinicia os serviços existentes (aceita serviços e opções)"
    "build|Reconstrói as imagens (aceita serviços e opções)"
    "status|Mostra o estado dos containers"
    "ps|Atalho para status"
    "logs|Acompanha os logs (aceita serviços e opções)"
    "artisan|Executa php artisan <args> no container"
    "tinker|Atalho para php artisan tinker"
    "composer|Executa composer <args> no container"
    "php|Executa php <args> no container"
    "pint|Executa vendor/bin/pint <args> no container"
    "check|Formata o PHP com Pint no container"
    "setup|Compila, inicia o ambiente e gera a APP_KEY se faltar"
    "demo|Prepara o ambiente de demonstração do zero (setup + migrate:fresh --seed)"
    "shell|Abre um Bash no container da aplicação"
    "exec|Executa um comando arbitrário: ./hackaton exec <cmd> [args]"
    "help|Mostra esta ajuda"
)

if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'; C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'
    C_BLUE=$'\e[34m'; C_CYAN=$'\e[36m'; C_GREEN=$'\e[32m'
    C_RED=$'\e[31m'; C_YELLOW=$'\e[33m'
else
    C_RESET=""; C_BOLD=""; C_DIM=""; C_BLUE=""; C_CYAN=""
    C_GREEN=""; C_RED=""; C_YELLOW=""
fi

info() { printf '%s[hackaton]%s %s\n' "$C_CYAN" "$C_RESET" "$*" >&2; }
warn() { printf '%s[hackaton]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
fail() { printf '%s[hackaton] %s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }

resolve_compose() {
    command -v docker >/dev/null 2>&1 || fail "Docker não encontrado. Instale o Docker."

    if docker compose version >/dev/null 2>&1; then
        COMPOSE_BIN=(docker compose)
    elif command -v docker-compose >/dev/null 2>&1; then
        COMPOSE_BIN=(docker-compose)
    else
        fail "Docker Compose não encontrado. Instale o plugin 'docker compose'."
    fi
}

compose() {
    "${COMPOSE_BIN[@]}" --project-directory "$PROJECT_DIR" --file "$PROJECT_DIR/compose.yaml" "$@"
}

ensure_env() {
    if [[ ! -e "$PROJECT_DIR/.env" ]]; then
        cp -- "$PROJECT_DIR/.env.example" "$PROJECT_DIR/.env"
        info ".env criado a partir de .env.example. Use ./hackaton setup para gerar a APP_KEY."
    fi
}

is_running() {
    local container_id
    container_id="$(compose ps --status running -q "$SERVICE")" || return 1
    [[ -n "$container_id" ]]
}

ensure_running() {
    ensure_env
    if ! is_running; then
        info "Container da aplicação não está rodando. Iniciando com suas dependências..."
        compose up -d "$SERVICE"
    fi
}

# Agentes e CI executam sem TTY; terminais interativos preservam o TTY.
run_in_container() {
    ensure_running
    local tty_flags=()
    if [[ ! -t 0 || ! -t 1 ]]; then
        tty_flags=(-T)
    fi
    compose exec "${tty_flags[@]}" "$SERVICE" "$@"
}

BANNER_ARTS=(
'   _   _    _    ____ _  __    _  _____ ___  _   _
  | | | |  / \  / ___| |/ /   / \|_   _/ _ \| \ | |
  | |_| | / _ \| |   | '\'' /   / _ \ | || | | |  \| |
  |  _  |/ ___ \ |___| . \  / ___ \| || |_| | |\  |
  |_| |_/_/   \_\____|_|\_\/_/   \_\_| \___/|_| \_|'
'   +------------------------------------------+
   |                 HACKATHON                |
   |         Laravel + Docker Compose         |
   +------------------------------------------+'
)

banner() {
    printf '\n%s%s%s%s\n' "$C_BLUE" "$C_BOLD" "${BANNER_ARTS[RANDOM % ${#BANNER_ARTS[@]}]}" "$C_RESET"
    printf '   %sProjeto Hackathon — ambiente de desenvolvimento%s\n' "$C_DIM" "$C_RESET"
}

cmd_help() {
    banner
    printf '\n%sUso:%s ./hackaton <comando> [argumentos]\n' "$C_BOLD" "$C_RESET"
    printf '\n%sComandos disponíveis:%s\n' "$C_BOLD" "$C_RESET"
    local entry name description
    for entry in "${COMMANDS[@]}"; do
        name="${entry%%|*}"
        description="${entry#*|}"
        printf '  %s%-10s%s %s\n' "$C_GREEN" "$name" "$C_RESET" "$description"
    done
    printf '\n%sExemplos:%s\n' "$C_BOLD" "$C_RESET"
    printf '  ./hackaton %s\n' 'setup' 'dev' 'artisan migrate --no-interaction' 'logs app' 'pint --test' 'exec ls -la'
    printf '\n'
    printf '%s\n' \
        'O build instala Composer/npm e compila os assets; Node não está na imagem final.' \
        'O código é copiado para a imagem: após alterações locais, execute ./hackaton dev.' \
        'Composer e Pint no container não alteram os arquivos do projeto no host.' \
        'Atenção: down --volumes apaga os dados persistidos, incluindo o banco.'
}

cmd_dev() {
    ensure_env
    compose up -d --build "$@"
    info "Serviços iniciados. Consulte as portas com ./hackaton status."
    info "Acompanhe os logs com ./hackaton logs."
}

cmd_stop() { compose stop "$@"; }
cmd_down() { compose down "$@"; }
cmd_restart() { compose restart "$@"; }
cmd_build() { ensure_env; compose build "$@"; }
cmd_status() { compose ps "$@"; }
cmd_ps() { cmd_status "$@"; }
cmd_logs() { compose logs --follow --tail=100 "$@"; }

cmd_artisan() { run_in_container php artisan "$@"; }
cmd_tinker() { run_in_container php artisan tinker "$@"; }
cmd_composer() { run_in_container composer "$@"; }
cmd_php() { run_in_container php "$@"; }
cmd_pint() { run_in_container vendor/bin/pint "$@"; }
cmd_check() { cmd_pint --format agent "$@"; }
cmd_shell() { run_in_container bash "$@"; }

cmd_exec() {
    [[ $# -gt 0 ]] || fail "Informe o comando. Ex.: ./hackaton exec ls -la"
    run_in_container "$@"
}

cmd_setup() {
    cmd_dev "$@"
    if ! grep -qE "^APP_KEY=['\"]?[^'\"[:space:]#]+" "$PROJECT_DIR/.env"; then
        cmd_artisan key:generate --no-interaction
    fi
    info "Ambiente configurado. Execute ./hackaton artisan migrate --no-interaction quando necessário."
}

cmd_demo() {
    cmd_setup "$@"
    cmd_artisan migrate:fresh --seed --force --no-interaction
    info "Demonstração pronta. Acesse com recrutador@setic.demo / demo1234."
}

main() {
    local command="${1:-help}"
    if [[ $# -gt 0 ]]; then
        shift
    fi

    case "$command" in
        -h|--help) command="help" ;;
    esac

    local handler="cmd_${command//-/_}"
    if ! declare -F "$handler" >/dev/null; then
        warn "Comando desconhecido: $command"
        cmd_help >&2
        exit 2
    fi

    if [[ "$command" != "help" ]]; then
        resolve_compose
    fi

    "$handler" "$@"
}

main "$@"
